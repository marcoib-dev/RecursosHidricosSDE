# ═══════════════════════════════════════════════════════════════
# Recursos Hídricos SDE — Variables para Docker Compose
# ═══════════════════════════════════════════════════════════════
# 1. Copiar este archivo:
#      cp .env.produccion.example .env.produccion
# 2. Reemplazar TODOS los valores marcados con CAMBIAR_.
# 3. Nunca commitear .env.produccion (ya está en .gitignore).
#
# Uso:
#   docker compose --env-file .env.produccion -f docker-compose.prod.yaml up -d --build
# ═══════════════════════════════════════════════════════════════

# ─── Base de datos ─────────────────────────────────────────────
# Contraseña del usuario root de MySQL. Solo se usa para administración
# interna del contenedor; la aplicación NO se conecta con root.
MYSQL_ROOT_PASSWORD=CAMBIAR_password_root_de_ejemplo_123

# Nombre de la base. Debe coincidir con el esquema de backend/database.sql.
DB_NAME=recursos_hidricos_sde

# Usuario de aplicación que crea la imagen de MySQL automáticamente.
# No puede ser "root".
DB_USER=rh_app
DB_PASSWORD=CAMBIAR_password_del_usuario_app_456

# Host y puerto vistos desde el contenedor del backend.
# "db" es el nombre del servicio en docker-compose.prod.yaml.
DB_HOST=db
DB_PORT=3306

# ─── Autenticación ─────────────────────────────────────────────
# Obligatorio en producción. Debe ser único, aleatorio y tener al menos
# 32 caracteres. Si falta, es el valor por defecto antiguo o es más corto,
# el backend no arranca. Generar uno nuevo con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# (o: openssl rand -hex 64)
JWT_SECRET=CAMBIAR_generar_64_bytes_aleatorios_en_hex_no_usar_este_valor
JWT_EXPIRES_IN=7d

# ─── Primer administrador ──────────────────────────────────────
# Independiente de SEED_DEMO. Si la base no tiene ningún usuario con rol
# administrador, el arranque del backend crea uno con estos datos.
# Requisitos:
#   - ADMIN_EMAIL y ADMIN_PASSWORD deben estar definidos.
#   - ADMIN_PASSWORD debe tener al menos 12 caracteres.
#   - Si falta alguna variable o la contraseña es corta, NO se crea nada
#     y se muestra una advertencia en los logs (nunca la contraseña).
#   - Nunca sobrescribe usuarios existentes ni resetea contraseñas.
# Los valores de ejemplo son ficticios: reemplazarlos antes de desplegar.
ADMIN_EMAIL=admin@ejemplo.invalid
ADMIN_PASSWORD=CAMBIAR_password_administrador_de_ejemplo_123
ADMIN_NOMBRE=Administrador General

# ─── Backend ───────────────────────────────────────────────────
# URL pública del frontend, usada por CORS. En este despliegue el
# navegador accede por el mismo origen a /api, pero conviene dejarla
# con el dominio o IP reales.
FRONTEND_URL=http://localhost

# Número de proxies de confianza delante del backend.
# 1 = nginx del frontend (valor por defecto).
# Si se agrega otro proxy delante de ese nginx (por ejemplo, el del
# servidor del ITSE), subirlo a 2 para que req.ip siga siendo la IP
# real del cliente y el rate limit no se aplique de forma global.
# También acepta "false" o "0" para desactivarlo.
TRUST_PROXY=1

# ─── Frontend / publicación ────────────────────────────────────
# Puerto del host que se publica. Usar 8080 si el servidor ya usa el 80.
HTTP_PORT=80

# ─── Datos de ejemplo (opcional) ───────────────────────────────
# true  = carga usuarios y obras demo la primera vez (seed idempotente).
# false = base vacía, solo esquema (recomendado en producción real).
SEED_DEMO=false
